# Copy to .env before running Compose. Passwords are development placeholders;
# replace every value and keep them URL-safe because they appear in DATABASE_URL.
POSTGRES_DB=straylight
STRAYLIGHT_ENV=development
STRAYLIGHT_LEGACY_API_ENABLED=true
STRAYLIGHT_EVALUATION_API_ENABLED=true
# Experimental derived Markdown projections. Keep both dark until E07/E08 pass.
STRAYLIGHT_SUPERSESSION_DEMOTION=false
STRAYLIGHT_SUPERSESSION_DEMOTION_WEIGHT=1.5
STRAYLIGHT_INTENTION_LEDGER=false
STRAYLIGHT_DATABASE_IMAGE=straylight-postgres:release-blocked
POSTGRES_ADMIN_PASSWORD=replace_admin_password
POSTGRES_APP_RW_PASSWORD=replace_rw_password
POSTGRES_APP_RO_PASSWORD=replace_ro_password

MINIO_ROOT_USER=straylight_admin
MINIO_ROOT_PASSWORD=replace_minio_root_password
STRAYLIGHT_MINIO_BUCKET=straylight
STRAYLIGHT_MINIO_REGION=us-east-1
STRAYLIGHT_MINIO_ACCESS_KEY=straylight_app
STRAYLIGHT_MINIO_SECRET_KEY=replace_minio_app_secret
# The API prefers these generic S3 settings while retaining every
# STRAYLIGHT_MINIO_* name above as a backward-compatible alias. A custom
# endpoint defaults to path-style addressing; development defaults to creating
# a missing bucket. Either behavior can be overridden with:
# STRAYLIGHT_S3_FORCE_PATH_STYLE=true
# STRAYLIGHT_S3_CREATE_BUCKET=true
STRAYLIGHT_S3_ENDPOINT=http://minio:9000
STRAYLIGHT_S3_REGION=us-east-1
STRAYLIGHT_S3_BUCKET=straylight
STRAYLIGHT_S3_ACCESS_KEY=straylight_app
STRAYLIGHT_S3_SECRET_KEY=replace_minio_app_secret
# For AWS S3 in production, omit STRAYLIGHT_S3_ENDPOINT and both explicit key
# variables. The AWS SDK then uses its default credential chain, including web
# identity and container/instance workload identity. Production defaults to
# virtual-hosted addressing and never creates a missing bucket.

STRAYLIGHT_CONTINUATION_SIGNING_KEY=replace_with_at_least_32_random_bytes
STRAYLIGHT_EMBEDDING_PROVIDER=openai
STRAYLIGHT_ALLOW_DEGRADED_EMBEDDINGS=false
STRAYLIGHT_EMBEDDING_MODEL=text-embedding-3-small
STRAYLIGHT_EMBEDDING_DIMENSIONS=1536
STRAYLIGHT_OBSERVABILITY_TIMINGS_MS=true
STRAYLIGHT_VERBATIM_SPANS=false
STRAYLIGHT_DREAM_MODEL=gpt-5.6
STRAYLIGHT_CAPTURE_MODEL=gpt-5.6
STRAYLIGHT_CAPTURE_MAX_OUTPUT_TOKENS=8192
STRAYLIGHT_DREAM_SCHEDULER_ENABLED=false
STRAYLIGHT_DREAM_SCHEDULER_POLL_SECONDS=15
STRAYLIGHT_DREAM_INACTIVITY_SECONDS=60
STRAYLIGHT_DREAM_COOLDOWN_SECONDS=900
STRAYLIGHT_DREAM_DIRTY_THRESHOLD=10
STRAYLIGHT_DATABASE_MAX_CONNECTIONS=20
# Self-hosted Compose PostgreSQL keeps enough WAL headroom that a large import
# or rebuildable embedding backlog does not force checkpoints every few seconds.
STRAYLIGHT_POSTGRES_MAX_WAL_SIZE=4GB
STRAYLIGHT_POSTGRES_MIN_WAL_SIZE=1GB
STRAYLIGHT_MATERIALIZE_TOKEN_BUDGET=24000
STRAYLIGHT_REQUEST_TIMEOUT_SECONDS=30
STRAYLIGHT_TRANSFER_TIMEOUT_SECONDS=3600
STRAYLIGHT_MAX_CONCURRENT_TRANSFERS=8
STRAYLIGHT_READINESS_TIMEOUT_SECONDS=3
STRAYLIGHT_REQUESTS_PER_MINUTE=600
# Empty denies cross-origin browser access. Add comma-separated HTTPS origins
# only when the API is intentionally called outside the same-origin SPA proxy.
STRAYLIGHT_ALLOWED_ORIGINS=
STRAYLIGHT_BACKGROUND_JOB_LEASE_SECONDS=300
STRAYLIGHT_ACCOUNT_EXPORT_TTL_HOURS=24
STRAYLIGHT_ACCOUNT_DELETION_BACKUP_RETENTION_DAYS=30
# Coordinated backup archives must not outlive the account-deletion retention
# window. The prune command enforces each v2 manifest's expiry.
STRAYLIGHT_BACKUP_RETENTION_DAYS=30
STRAYLIGHT_DEV_USER_REF=user:local
STRAYLIGHT_DEV_USER_NAME=Local user
STRAYLIGHT_DEV_READ_WRITE_TOKEN=
STRAYLIGHT_DEV_READ_ONLY_TOKEN=
# Raw token for the credential used by the typed stdio MCP adapter. Set this to
# a scoped read-only or read/write API token; it may match a dev token locally.
STRAYLIGHT_MCP_API_TOKEN=
STRAYLIGHT_MCP_IMPORT_ROOT=./imports
CARRYSTATE_MCP_ASSET_HOST_ROOT=./mcp-assets
OPENAI_API_KEY=
# Every application secret also accepts a sibling *_FILE variable, for example
# OPENAI_API_KEY_FILE=/run/secrets/openai_api_key. Never set both forms.
OPENAI_BASE_URL=https://api.openai.com/v1
CARRYSTATE_ASSET_DESCRIPTION_MODEL=gpt-5.6
CARRYSTATE_ASSET_DESCRIPTION_MAX_OUTPUT_TOKENS=4096
CARRYSTATE_ASSET_DESCRIPTION_IMAGE_DETAIL=high
RUST_LOG=info,straylight=debug

# Production observability. The API key is used only by the optional Datadog
# Agent Compose profile; Straylight sends local UDP DogStatsD packets to it.
STRAYLIGHT_METRICS_ENABLED=false
STRAYLIGHT_DOGSTATSD_ADDR=datadog-agent:8125
STRAYLIGHT_METRICS_FLUSH_SECONDS=3
DD_API_KEY=
DD_SITE=datadoghq.com
DD_ENV=development
DD_SERVICE=straylight
DD_VERSION=local
STRAYLIGHT_RELEASE_REVISION=unreleased
STRAYLIGHT_API_IMAGE=straylight-api:release-blocked
STRAYLIGHT_WEB_IMAGE=straylight-web:release-blocked
STRAYLIGHT_MCP_IMAGE=straylight-mcp:release-blocked
STRAYLIGHT_EDGE_IMAGE=straylight-caddy:release-blocked
STRAYLIGHT_OBJECT_STORE_IMAGE=straylight-object-store:release-blocked
STRAYLIGHT_OBJECT_STORE_CLIENT_IMAGE=straylight-object-store-client:release-blocked
DATADOG_AGENT_IMAGE=gcr.io/datadoghq/agent:7.81.2@sha256:44bfe2c475d9467e78e73e4327148d7e3902da5a48cbb1b0f6b84b01283e89d5
# Added to monitor messages only when monitors are installed, for example an
# approved email, Slack, or PagerDuty handle.
STRAYLIGHT_DATADOG_NOTIFY=

# Required only with compose.production.yaml. The edge obtains and renews TLS
# certificates automatically and exposes no database or object-store ports.
STRAYLIGHT_PUBLIC_HOST=memory.example.com
STRAYLIGHT_ACME_EMAIL=ops@example.com
STRAYLIGHT_SECRETS_DIR=./secrets

# Nyx port-map allocations.
STRAYLIGHT_WEB_PORT=13110
STRAYLIGHT_POSTGRES_PORT=15110
STRAYLIGHT_API_PORT=18110
STRAYLIGHT_MINIO_PORT=19110
STRAYLIGHT_MINIO_CONSOLE_PORT=19111
