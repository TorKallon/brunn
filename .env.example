# Copy to .env before running Compose. Passwords are development placeholders;
# replace every value and keep them URL-safe because they appear in DATABASE_URL.
POSTGRES_DB=brunn
BRUNN_ENV=development
BRUNN_LEGACY_API_ENABLED=true
BRUNN_EVALUATION_API_ENABLED=true
# Durable agent messaging stays dark until its release smoke passes.
BRUNN_MESSAGING_ENABLED=false
# Owner location reporting and the joined memory.open presence block default on.
BRUNN_LOCATION_PINGS_ENABLED=true
BRUNN_LOCATION_PRESENCE_IN_OPEN=true
# Experimental derived Markdown projections. Keep both dark until E07/E08 pass.
BRUNN_SUPERSESSION_DEMOTION=false
BRUNN_SUPERSESSION_DEMOTION_WEIGHT=1.5
BRUNN_INTENTION_LEDGER=false
# Default-off D03 experiment flag. Enable only in an isolated E06 stack.
BRUNN_RESUME_DELTAS=false
BRUNN_DATABASE_IMAGE=brunn-postgres:release-blocked
POSTGRES_ADMIN_PASSWORD=replace_admin_password
POSTGRES_APP_RW_PASSWORD=replace_rw_password
POSTGRES_APP_RO_PASSWORD=replace_ro_password

MINIO_ROOT_USER=brunn_admin
MINIO_ROOT_PASSWORD=replace_minio_root_password
BRUNN_MINIO_BUCKET=brunn
BRUNN_MINIO_REGION=us-east-1
BRUNN_MINIO_ACCESS_KEY=brunn_app
BRUNN_MINIO_SECRET_KEY=replace_minio_app_secret
# The API prefers these generic S3 settings while retaining every
# BRUNN_MINIO_* name above as a backward-compatible alias. A custom
# endpoint defaults to path-style addressing; development defaults to creating
# a missing bucket. Either behavior can be overridden with:
# BRUNN_S3_FORCE_PATH_STYLE=true
# BRUNN_S3_CREATE_BUCKET=true
BRUNN_S3_ENDPOINT=http://minio:9000
BRUNN_S3_REGION=us-east-1
BRUNN_S3_BUCKET=brunn
BRUNN_S3_ACCESS_KEY=brunn_app
BRUNN_S3_SECRET_KEY=replace_minio_app_secret
# For AWS S3 in production, omit BRUNN_S3_ENDPOINT and both explicit key
# variables. The AWS SDK then uses its default credential chain, including web
# identity and container/instance workload identity. Production defaults to
# virtual-hosted addressing and never creates a missing bucket.

BRUNN_CONTINUATION_SIGNING_KEY=replace_with_at_least_32_random_bytes
BRUNN_EMBEDDING_PROVIDER=openai
BRUNN_ALLOW_DEGRADED_EMBEDDINGS=false
BRUNN_EMBEDDING_MODEL=text-embedding-3-small
BRUNN_EMBEDDING_DIMENSIONS=1536
BRUNN_OBSERVABILITY_TIMINGS_MS=true
BRUNN_VERBATIM_SPANS=false
# D10/E05 experimental read-path flags. Both stay off until their deterministic
# and paired-draw gates have passed.
BRUNN_READ_PATH_ROUNDTRIP_V1=false
BRUNN_LEXICAL_SINGLE_SCAN=false
# Semantic retrieval is an experimental accelerator. Keep it off until E09
# establishes a reasoning-quality benefit. A zero deadline selects the E09
# unbounded arm (the outer 2.5s retrieval-lane timeout still applies).
BRUNN_SEMANTIC_LANE=false
BRUNN_EMBED_CACHE=true
BRUNN_SEMANTIC_DEADLINE_MS=2500
# Turning the canonical guard off halts embedding-backfill job claims. When on,
# publications are capped and paced. The worker reads the API process's rolling
# 60-second open/search p95 snapshot over the internal HTTP endpoint and fails
# closed (pauses claims) if that endpoint is stale, unavailable, or above a
# limit. Compose supplies its private service URL; hosted environments must set
# their own private API URL.
BRUNN_EMBEDDING_BACKFILL_GUARD=true
BRUNN_EMBEDDING_BACKFILL_BATCH_CHUNKS=64
BRUNN_EMBEDDING_BACKFILL_INTER_BATCH_MS=250
BRUNN_EMBEDDING_BACKFILL_OPEN_P95_LIMIT_MS=120
BRUNN_EMBEDDING_BACKFILL_SEARCH_P95_LIMIT_MS=107
BRUNN_EMBEDDING_BACKFILL_FOREGROUND_STATUS_URL=http://api:8080/health/foreground-latency
BRUNN_EMBEDDING_BACKFILL_FOREGROUND_STATUS_TIMEOUT_MS=1000
BRUNN_DREAM_MODEL=gpt-5.6
BRUNN_CAPTURE_MODEL=gpt-5.6
BRUNN_CAPTURE_MAX_OUTPUT_TOKENS=8192
BRUNN_DREAM_SCHEDULER_ENABLED=false
BRUNN_DREAM_SCHEDULER_POLL_SECONDS=15
BRUNN_DREAM_INACTIVITY_SECONDS=60
BRUNN_DREAM_COOLDOWN_SECONDS=900
BRUNN_DREAM_DIRTY_THRESHOLD=10
BRUNN_DATABASE_MAX_CONNECTIONS=20
# Self-hosted Compose PostgreSQL keeps enough WAL headroom that a large import
# or rebuildable embedding backlog does not force checkpoints every few seconds.
BRUNN_POSTGRES_MAX_WAL_SIZE=4GB
BRUNN_POSTGRES_MIN_WAL_SIZE=1GB
BRUNN_MATERIALIZE_TOKEN_BUDGET=24000
BRUNN_REQUEST_TIMEOUT_SECONDS=30
BRUNN_TRANSFER_TIMEOUT_SECONDS=3600
BRUNN_MAX_CONCURRENT_TRANSFERS=8
BRUNN_READINESS_TIMEOUT_SECONDS=3
BRUNN_REQUESTS_PER_MINUTE=600
# Empty denies cross-origin browser access. Add comma-separated HTTPS origins
# only when the API is intentionally called outside the same-origin SPA proxy.
BRUNN_ALLOWED_ORIGINS=
BRUNN_BACKGROUND_JOB_LEASE_SECONDS=300
BRUNN_ACCOUNT_EXPORT_TTL_HOURS=24
BRUNN_ACCOUNT_DELETION_BACKUP_RETENTION_DAYS=30
# Coordinated backup archives must not outlive the account-deletion retention
# window. The prune command enforces each v2 manifest's expiry.
BRUNN_BACKUP_RETENTION_DAYS=30
BRUNN_DEV_USER_REF=user:local
BRUNN_DEV_USER_NAME=Local user
BRUNN_DEV_READ_WRITE_TOKEN=
BRUNN_DEV_READ_ONLY_TOKEN=
# Raw token for the credential used by the typed stdio MCP adapter. Set this to
# a scoped read-only or read/write API token; it may match a dev token locally.
BRUNN_MCP_API_TOKEN=
BRUNN_MCP_IMPORT_ROOT=./imports
BRUNN_STATE_MCP_ASSET_HOST_ROOT=./mcp-assets
OPENAI_API_KEY=
# Resend is used only by the API for password-recovery email. Keep its key in
# a secret store; never expose it to the browser or commit a real value.
# When enabling recovery email, use AUTH_EMAIL_FROM=Brunn <login@solark.io>.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
AUTH_EMAIL_REPLY_TO=
BRUNN_PUBLIC_URL=http://localhost:13110
# Device tokens are encrypted before storage. Set either the direct value or
# its sibling _FILE path; the key must be base64 that decodes to exactly 32
# bytes. The APNs app ID is the iOS bundle ID and is not secret.
BRUNN_NOTIFICATION_TOKEN_ENCRYPTION_KEY=
BRUNN_NOTIFICATION_TOKEN_ENCRYPTION_KEY_FILE=
BRUNN_APNS_APP_ID=
# Keep transport disabled until provider credentials and signed-device canaries
# are ready. API and worker must receive the same value when this is enabled.
BRUNN_APNS_DELIVERY_ENABLED=false
# APNs provider credentials are injected only into the worker. Prefer the
# private-key _FILE form for the Apple .p8 key; never commit the key itself.
BRUNN_APNS_TEAM_ID=
BRUNN_APNS_KEY_ID=
BRUNN_APNS_PRIVATE_KEY=
BRUNN_APNS_PRIVATE_KEY_FILE=
# Every application secret also accepts a sibling *_FILE variable, for example
# OPENAI_API_KEY_FILE=/run/secrets/openai_api_key. Never set both forms.
OPENAI_BASE_URL=https://api.openai.com/v1
BRUNN_STATE_ASSET_DESCRIPTION_MODEL=gpt-5.6
BRUNN_STATE_ASSET_DESCRIPTION_MAX_OUTPUT_TOKENS=4096
BRUNN_STATE_ASSET_DESCRIPTION_IMAGE_DETAIL=high
RUST_LOG=info,brunn=debug

# Production observability. The API key is used only by the optional Datadog
# Agent Compose profile; Brunn sends local UDP DogStatsD packets to it.
BRUNN_METRICS_ENABLED=false
BRUNN_DOGSTATSD_ADDR=datadog-agent:8125
BRUNN_METRICS_FLUSH_SECONDS=3
DD_API_KEY=
DD_SITE=datadoghq.com
DD_ENV=development
DD_SERVICE=brunn
DD_VERSION=local
BRUNN_RELEASE_REVISION=unreleased
BRUNN_API_IMAGE=brunn-api:release-blocked
BRUNN_WEB_IMAGE=brunn-web:release-blocked
BRUNN_MCP_IMAGE=brunn-mcp:release-blocked
BRUNN_EDGE_IMAGE=brunn-caddy:release-blocked
BRUNN_OBJECT_STORE_IMAGE=brunn-object-store:release-blocked
BRUNN_OBJECT_STORE_CLIENT_IMAGE=brunn-object-store-client:release-blocked
DATADOG_AGENT_IMAGE=gcr.io/datadoghq/agent:7.81.2@sha256:44bfe2c475d9467e78e73e4327148d7e3902da5a48cbb1b0f6b84b01283e89d5
# Added to monitor messages only when monitors are installed, for example an
# approved email, Slack, or PagerDuty handle.
BRUNN_DATADOG_NOTIFY=

# Required only with compose.production.yaml. The edge obtains and renews TLS
# certificates automatically and exposes no database or object-store ports.
BRUNN_PUBLIC_HOST=memory.example.com
BRUNN_ACME_EMAIL=ops@example.com
BRUNN_SECRETS_DIR=./secrets

# Nyx port-map allocations.
BRUNN_WEB_PORT=13110
BRUNN_POSTGRES_PORT=15110
BRUNN_API_PORT=18110
BRUNN_MINIO_PORT=19110
BRUNN_MINIO_CONSOLE_PORT=19111
