# Copy to .env before running Compose. Passwords are development placeholders;
# replace every value and keep them URL-safe because they appear in DATABASE_URL.
POSTGRES_DB=straylight
POSTGRES_ADMIN_PASSWORD=replace_admin_password
POSTGRES_APP_RW_PASSWORD=replace_rw_password
POSTGRES_APP_RO_PASSWORD=replace_ro_password

MINIO_ROOT_USER=straylight_admin
MINIO_ROOT_PASSWORD=replace_minio_root_password
STRAYLIGHT_MINIO_BUCKET=straylight
STRAYLIGHT_MINIO_REGION=us-east-1
STRAYLIGHT_MINIO_ACCESS_KEY=straylight_app
STRAYLIGHT_MINIO_SECRET_KEY=replace_minio_app_secret

STRAYLIGHT_CONTINUATION_SIGNING_KEY=replace_with_at_least_32_random_bytes
STRAYLIGHT_EMBEDDING_PROVIDER=openai
STRAYLIGHT_EMBEDDING_MODEL=text-embedding-3-small
STRAYLIGHT_EMBEDDING_DIMENSIONS=1536
STRAYLIGHT_DREAM_MODEL=gpt-5.6
STRAYLIGHT_CAPTURE_MODEL=gpt-5.6
STRAYLIGHT_CAPTURE_MAX_OUTPUT_TOKENS=8192
STRAYLIGHT_DREAM_SCHEDULER_ENABLED=true
STRAYLIGHT_DREAM_SCHEDULER_POLL_SECONDS=15
STRAYLIGHT_DREAM_INACTIVITY_SECONDS=60
STRAYLIGHT_DREAM_COOLDOWN_SECONDS=900
STRAYLIGHT_DREAM_DIRTY_THRESHOLD=10
STRAYLIGHT_DATABASE_MAX_CONNECTIONS=20
STRAYLIGHT_MATERIALIZE_TOKEN_BUDGET=24000
STRAYLIGHT_REQUEST_TIMEOUT_SECONDS=30
STRAYLIGHT_DEV_USER_REF=user:local
STRAYLIGHT_DEV_USER_NAME=Local user
STRAYLIGHT_DEV_READ_WRITE_TOKEN=
STRAYLIGHT_DEV_READ_ONLY_TOKEN=
# Raw token for the credential used by the typed stdio MCP adapter. Set this to
# a scoped read-only or read/write API token; it may match a dev token locally.
STRAYLIGHT_MCP_API_TOKEN=
STRAYLIGHT_MCP_IMPORT_ROOT=./imports
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
RUST_LOG=info,straylight=debug

# Nyx port-map allocations.
STRAYLIGHT_WEB_PORT=13110
STRAYLIGHT_POSTGRES_PORT=15110
STRAYLIGHT_API_PORT=18110
STRAYLIGHT_MINIO_PORT=19110
STRAYLIGHT_MINIO_CONSOLE_PORT=19111
