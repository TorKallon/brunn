# syntax=docker/dockerfile:1.7
# The dreamer runner: the brunn Rust binary plus node, the codex CLI,
# and the built stdio MCP server. Runs `brunn dreamer serve` — the
# nightly consolidation wrapper and the Connect flow's private HTTP surface.
FROM rust:1.96.1-bookworm@sha256:a339861ae23e9abb272cea45dfafde21760d2ce6577a70f8a926153677902663 AS builder

ARG BRUNN_BUILD_REVISION=unknown
ENV BRUNN_BUILD_REVISION=${BRUNN_BUILD_REVISION} \
    CARGO_BUILD_JOBS=2 \
    CARGO_INCREMENTAL=0
WORKDIR /build
COPY apps/api/Cargo.toml apps/api/Cargo.lock* ./
COPY apps/api/build.rs ./
COPY apps/api/src ./src
COPY apps/api/migrations ./migrations
RUN cargo build --release \
    && cp /build/target/release/brunn /build/brunn

FROM node:24.18.0-bookworm-slim@sha256:6f7b03f7c2c8e2e784dcf9295400527b9b1270fd37b7e9a7285cf83b6951452d AS mcp-build
WORKDIR /mcp
COPY apps/mcp/package.json apps/mcp/package-lock.json ./
RUN npm ci
COPY apps/mcp/tsconfig.json ./
COPY apps/mcp/src ./src
RUN npm run build && npm prune --omit=dev

FROM node:24.18.0-bookworm-slim@sha256:6f7b03f7c2c8e2e784dcf9295400527b9b1270fd37b7e9a7285cf83b6951452d AS runtime
ARG BRUNN_BUILD_REVISION=unknown
LABEL org.opencontainers.image.title="Brunn Dreamer" \
      org.opencontainers.image.revision="${BRUNN_BUILD_REVISION}"
# The codex CLI is a native binary that verifies TLS against the system
# store, which the slim image does not ship.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN npm install -g @openai/codex && npm cache clean --force
COPY --from=builder /build/brunn /usr/local/bin/brunn
COPY --from=mcp-build /mcp/dist /srv/mcp/dist
COPY --from=mcp-build /mcp/node_modules /srv/mcp/node_modules
COPY --from=mcp-build /mcp/package.json /srv/mcp/package.json
# Not under /tmp: codex refuses to create its PATH helper aliases there.
RUN mkdir -p /srv/dreamer && chown node:node /srv/dreamer

ENV DREAMER_MCP_ENTRY=/srv/mcp/dist/index.js \
    DREAMER_CODEX_PATH=/usr/local/bin/codex \
    DREAMER_WORK_ROOT=/srv/dreamer

USER node:node
EXPOSE 8090
ENTRYPOINT ["/usr/local/bin/brunn"]
CMD ["dreamer", "serve"]
