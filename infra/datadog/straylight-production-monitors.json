[
  {
    "name": "[Straylight] API heartbeat missing",
    "type": "metric alert",
    "query": "avg(last_5m):avg:straylight.runtime.alive{env:__DD_ENV__,service:__DD_SERVICE__,component:api} < 1",
    "message": "The Straylight API has stopped reporting its runtime heartbeat. Check deployment health, container state, and dependency readiness.__NOTIFY__",
    "tags": ["env:__DD_ENV__", "service:__DD_SERVICE__", "managed_by:straylight"],
    "options": {
      "include_tags": true,
      "notify_audit": true,
      "notify_no_data": true,
      "no_data_timeframe": 5,
      "require_full_window": false,
      "renotify_interval": 30,
      "thresholds": {"critical": 1}
    }
  },
  {
