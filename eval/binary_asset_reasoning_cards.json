        "model_output_tokens",
        "uncached_input_tokens",
        "tool_calls",
        "tool_bytes",
        "wall_time_ms",
        "provider_cost_usd"
      ]
    },
    "matched-filesystem": {
      "interface": "filesystem tools over a per-card directory containing exactly the evidence bytes selected in the successful CarryState run",
      "corpus_projection": "Content-matched control. Discovery is removed, but source Markdown, generated descriptions, and native files are byte-identical to CarryState.",
