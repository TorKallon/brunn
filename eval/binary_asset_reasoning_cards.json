        "uncached_input_tokens",
        "tool_calls",
        "tool_bytes",
        "wall_time_ms",
        "provider_cost_usd"
      ]
    },
    "operational-filesystem": {
      "interface": "ordinary agent filesystem tools over the complete r2 mixed vault",
      "corpus_projection": "Realistic local-vault control. The agent must discover relevant files in the full current snapshot and may inspect native files with standard local utilities.",
      "source_parity": "The full current fixture has the same logical paths and native bytes as CarryState; no preselected context pack is supplied.",
      "allowed_tools": [
        "find",
        "rg",
