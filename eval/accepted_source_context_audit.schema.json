{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "brunn-accepted-source-context-audit@v1",
  "title": "Brunn accepted-source-in-context audit",
  "type": "object",
  "required": [
    "schema",
    "created_at",
    "source_revision",
    "grading_revision",
    "service_provenance",
    "input_artifacts",
    "summary",
    "claims"
  ],
  "properties": {
    "schema": {
      "const": "brunn-accepted-source-context-audit@v1"
    },
    "created_at": {
      "type": "string"
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
    },
    "grading_revision": {
      "type": "string",
      "minLength": 1
    },
    "service_provenance": {
      "type": "object",
      "required": [
        "schema",
        "status",
        "expected_arm_retrieval_modes",
        "service_arms",
        "source_revision",
        "build_revision",
        "api_image_id",
        "api_image_revision",
        "distinct_container_instances_allowed"
      ],
      "properties": {
        "schema": {
          "const": "brunn-aggregate-service-provenance-summary@v1"
        },
        "status": {
          "const": "complete"
        },
        "expected_arm_retrieval_modes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["exact", "lexical", "semantic"]
            }
          }
        },
        "service_arms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_revision": {
          "type": "string",
          "minLength": 1
        },
        "build_revision": {
          "type": "string",
          "minLength": 1
        },
        "api_image_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "api_image_revision": {
          "type": "string",
          "minLength": 1
        },
        "distinct_container_instances_allowed": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "input_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "all_claims",
        "missed_claims",
        "by_arm",
        "by_suite"
      ]
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "suite",
          "run_id",
          "paired_draw_id",
          "arm",
          "case_id",
          "claim_id",
          "claim_pass",
          "missed_claim",
          "accepted_sources",
          "returned_source_paths",
          "matched_accepted_sources",
          "accepted_source_in_context"
        ]
      }
    }
  },
  "additionalProperties": false
}
