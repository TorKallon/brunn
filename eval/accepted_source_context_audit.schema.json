{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "straylight-accepted-source-context-audit@v1",
  "title": "Straylight accepted-source-in-context audit",
  "type": "object",
  "required": [
    "schema",
    "created_at",
    "source_revision",
    "grading_revision",
    "input_artifacts",
    "summary",
    "claims"
  ],
  "properties": {
    "schema": {
      "const": "straylight-accepted-source-context-audit@v1"
    },
    "created_at": {
      "type": "string"
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
    },
    "grading_revision": {
      "type": "string",
      "minLength": 1
    },
    "input_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "all_claims",
        "missed_claims",
        "by_arm",
        "by_suite"
      ]
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "suite",
          "run_id",
          "paired_draw_id",
          "arm",
          "case_id",
          "claim_id",
          "claim_pass",
          "missed_claim",
          "accepted_sources",
          "returned_source_paths",
          "matched_accepted_sources",
          "accepted_source_in_context"
        ]
      }
    }
  },
  "additionalProperties": false
}
