{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://straylight.local/schemas/owner-link-leak-request-v1.json",
  "title": "Straylight owner link-case leak request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "checks"],
  "properties": {
    "schema": {"const": "straylight-owner-link-leak-request@v1"},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "claim_id", "text"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "claim_id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
