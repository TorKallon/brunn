              "Events/schedule-snapshot-r2.md"
            ],
            "confidence": "high"
          },
          {
            "id": "c3",
            "value": "Original time: 2026-08-16T09:00:00-07:00. Current scheduled time: 2026-08-16T11:30:00-07:00. Actual time: still unknown/null.",
            "source_paths": [
              "Events/schedule-snapshot-r1.md",
              "Events/schedule-snapshot-r2.md"
            ],
            "confidence": "high"
          },
          {
            "id": "c4",
            "value": "The family copy is a stale derivative snapshot with no schedule authority. Guardian/family authority covers participation consent and sharing/export decisions, not edits to official event schedules; organizer authority controls schedule facts.",
            "source_paths": [
              "Events/schedule-snapshot-r1.md",
              "Policy/minor-sharing-policy.md"
            ],
            "confidence": "high"
          }
        ],
        "checkpoint": {
